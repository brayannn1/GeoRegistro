<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la incidencia"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCategoriaIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoría" />

            <TextView
                android:id="@+id/txtDescripcionIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción" />

            <TextView
                android:id="@+id/txtFechaIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha y hora" />

            <TextView
                android:id="@+id/txtEstadoIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnVerMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver mapa" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
